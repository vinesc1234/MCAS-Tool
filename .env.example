# Copy to .env.local for local development, and set the same two values as
# Environment Variables in the Vercel dashboard for production.
#
# Never commit .env.local — it is gitignored.

# Your Anthropic API key. Lives only on the server; never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Shared passcode you and your wife enter once, in Settings, on each phone.
# This stops a stranger who finds the URL from running up API charges.
# Make it long and random — you only type it twice, ever.
APP_PASSCODE=
